{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --delete *)",
      "Bash(git push --tags *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git tag *)",
      "Bash(git submodule deinit *)",
      "Bash(gh repo delete *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh run delete *)",
      "Bash(gh api *)",
      "Bash(poetry publish *)",
      "Bash(twine *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Set-ExecutionPolicy *)"
    ]
  }
}
